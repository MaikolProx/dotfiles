{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "mBg": "#06182b",
    "mPanel": "#0a2238",
    "mElem": "#0e2c47",
    "mBorder": "#1a4062",
    "mBorderActive": "#2a5a85",
    "mBorderSubtle": "#143351",
    "mText": "#dbeafe",
    "mBright": "#e6f6ff",
    "mMuted": "#6b8cae",
    "mComment": "#4a6a8c",
    "mCyan": "#22d3ee",
    "mSky": "#7dd3fc",
    "mBlue": "#58a6ff",
    "mSoft": "#8bb7ff",
    "mPale": "#b9d2ff",
    "mIce": "#a9ccff",
    "mAqua": "#9be1fa",
    "mSpark": "#67e8f9",
    "lBg": "#eef6ff",
    "lPanel": "#ddebfa",
    "lElem": "#cfe2f6",
    "lBorder": "#9dc0dd",
    "lBorderActive": "#5f8fb6",
    "lText": "#0b2740",
    "lMuted": "#41647f",
    "lBlue": "#1663c7",
    "lSoft": "#3b6fa8"
  },
  "theme": {
    "primary": { "dark": "mCyan", "light": "lBlue" },
    "secondary": { "dark": "mBlue", "light": "lBlue" },
    "accent": { "dark": "mSky", "light": "lBlue" },
    "error": { "dark": "mSoft", "light": "lSoft" },
    "warning": { "dark": "mPale", "light": "lSoft" },
    "success": { "dark": "mSky", "light": "lBlue" },
    "info": { "dark": "mBlue", "light": "lBlue" },
    "text": { "dark": "mText", "light": "lText" },
    "textMuted": { "dark": "mMuted", "light": "lMuted" },
    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "none", "light": "none" },
    "backgroundElement": { "dark": "none", "light": "none" },
    "border": { "dark": "mBorderActive", "light": "lBorderActive" },
    "borderActive": { "dark": "mCyan", "light": "lBlue" },
    "borderSubtle": { "dark": "mBorder", "light": "lBorder" },
    "diffAdded": { "dark": "mSky", "light": "lBlue" },
    "diffRemoved": { "dark": "mSoft", "light": "lSoft" },
    "diffContext": { "dark": "mMuted", "light": "lMuted" },
    "diffHunkHeader": { "dark": "mComment", "light": "lMuted" },
    "diffHighlightAdded": { "dark": "mAqua", "light": "lBlue" },
    "diffHighlightRemoved": { "dark": "mIce", "light": "lSoft" },
    "diffAddedBg": { "dark": "none", "light": "none" },
    "diffRemovedBg": { "dark": "none", "light": "none" },
    "diffContextBg": { "dark": "none", "light": "none" },
    "diffLineNumber": { "dark": "mBorderActive", "light": "lBorderActive" },
    "diffAddedLineNumberBg": { "dark": "none", "light": "none" },
    "diffRemovedLineNumberBg": { "dark": "none", "light": "none" },
    "markdownText": { "dark": "mText", "light": "lText" },
    "markdownHeading": { "dark": "mCyan", "light": "lBlue" },
    "markdownLink": { "dark": "mBlue", "light": "lBlue" },
    "markdownLinkText": { "dark": "mSky", "light": "lBlue" },
    "markdownCode": { "dark": "mAqua", "light": "lSoft" },
    "markdownBlockQuote": { "dark": "mMuted", "light": "lMuted" },
    "markdownEmph": { "dark": "mPale", "light": "lSoft" },
    "markdownStrong": { "dark": "mBright", "light": "lText" },
    "markdownHorizontalRule": { "dark": "mBorderActive", "light": "lBorder" },
    "markdownListItem": { "dark": "mBlue", "light": "lBlue" },
    "markdownListEnumeration": { "dark": "mCyan", "light": "lBlue" },
    "markdownImage": { "dark": "mBlue", "light": "lBlue" },
    "markdownImageText": { "dark": "mSky", "light": "lBlue" },
    "markdownCodeBlock": { "dark": "mText", "light": "lText" },
    "syntaxComment": { "dark": "mComment", "light": "lMuted" },
    "syntaxKeyword": { "dark": "mBlue", "light": "lBlue" },
    "syntaxFunction": { "dark": "mCyan", "light": "lBlue" },
    "syntaxVariable": { "dark": "mSky", "light": "lSoft" },
    "syntaxString": { "dark": "mAqua", "light": "lSoft" },
    "syntaxNumber": { "dark": "mIce", "light": "lBlue" },
    "syntaxType": { "dark": "mSpark", "light": "lBlue" },
    "syntaxOperator": { "dark": "mSoft", "light": "lBlue" },
    "syntaxPunctuation": { "dark": "mPale", "light": "lText" }
  }
}
